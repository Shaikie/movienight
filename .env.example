# Supabase project URL (safe to expose publicly)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon/public key for browser-based Supabase Auth (student login). SAFE to expose.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_anon_your_anon_key

# Supabase secret API key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Host dashboard password and a long random signing secret (32+ characters)
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional: enables live movie search and posters.
TMDB_API_KEY=your_tmdb_api_key
